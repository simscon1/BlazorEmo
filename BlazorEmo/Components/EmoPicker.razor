@using BlazorEmo.Models
@using BlazorEmo.Services
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Web.Virtualization

@if (IsOpen)
{
    <div class="emoji-picker-backdrop" 
         @onclick="HandleBackdropClick"
         @onclick:stopPropagation>
        
        <div class="emoji-picker emoji-picker-open"
             role="dialog"
             aria-label="Emoji picker"
             aria-describedby="emoji-picker-description"
             aria-modal="true"
             @onclick:stopPropagation
             @onkeydown="HandleKeyDown"
             @ref="_pickerElement">
            
            <div id="emoji-picker-description" class="sr-only">
                Search and select emojis by category or keyword. Use Tab to navigate, arrow keys to browse emojis, and Enter to select.
            </div>

            <!-- Search Box -->
            <div class="emoji-picker-search">
                <label for="emoji-search" class="sr-only">Search emojis</label>
                <input id="emoji-search"
                       type="text" 
                       role="searchbox"
                       aria-label="Search emojis"
                       aria-controls="emoji-content"
                       placeholder="Search emojis..." 
                       value="@searchQuery"
                       @oninput="OnSearchInput"
                       @onkeydown="HandleSearchKeyDown"
                       @onkeydown:stopPropagation
                       @ref="_searchInput"
                       class="emoji-search-input" />
            </div>
            
            <!-- Tab Bar -->
            <div class="emoji-tabs" 
                 role="tablist"
                 aria-label="Emoji categories"
                 @onkeydown="HandleTabsContainerKeyDown"
                 @onkeydown:preventDefault
                 @onkeydown:stopPropagation>
                
                <button type="button" 
                        role="tab"
                        aria-selected="@(activeTab == "recent")"
                        aria-controls="emoji-content"
                        class="emoji-tab @(activeTab == "recent" ? "active" : "")"
                        data-tab-name="recent"
                        @onclick='() => SelectTab("recent")'
                        @onmouseenter='() => OnTabMouseEnter("Recently Used")'
                        @onmouseleave="OnTabMouseLeave"
                        tabindex="@(activeTab == "recent" ? 0 : -1)">
                    <span aria-hidden="true">⏱️</span>
                    <span class="sr-only">Recently used</span>
                </button>
                
                @if (_allCategories != null)
                {
                    @foreach (var category in _allCategories)
                    {
                        var icon = GetCategoryIcon(category.Name);
                        var categoryName = category.Name;
                        <button type="button" 
                                role="tab"
                                aria-selected="@(activeTab == categoryName)"
                                aria-controls="emoji-content"
                                class="emoji-tab @(activeTab == categoryName ? "active" : "")"
                                data-tab-name="@categoryName"
                                @onclick="() => SelectTab(categoryName)"
                                @onmouseenter="() => OnTabMouseEnter(categoryName)"
                                @onmouseleave="OnTabMouseLeave"
                                tabindex="@(activeTab == categoryName ? 0 : -1)">
                            <span aria-hidden="true">@icon</span>
                            <span class="sr-only">@categoryName</span>
                        </button>
                    }
                }
            </div>
            
            <!-- Content Area -->
            <div id="emoji-content" 
                 class="emoji-picker-content"
                 role="tabpanel"
                 aria-label="@GetAriaLabelForContent()"
                 aria-live="polite"
                 @onkeydown="HandleEmojiContainerKeyDown"
                 @onkeydown:preventDefault
                 @onkeydown:stopPropagation>
    
                <!-- Fixed Category Name Display -->
                <div class="emoji-content-header">
                    <span class="emoji-current-category">@activeTab</span>
                    <span class="emoji-name-display">@_hoveredEmojiName</span>
                </div>
    
                <div class="emoji-scrollable-content" @ref="_scrollContainer">
                    @if (_categories == null)
                    {
                        <div class="emoji-picker-loading" role="status" aria-live="polite">
                            <span>Loading emojis...</span>
                        </div>
                    }
                    else if (!_categories.Any())
                    {
                        <div class="emoji-picker-empty" role="status">
                            @if (activeTab == "recent")
                            {
                                <span>No recent emojis yet. Select an emoji to get started.</span>
                            }
                            else
                            {
                                <span>No emojis found matching "@searchQuery"</span>
                            }
                        </div>
                    }
                    else
                    {
                        @foreach (var category in _categories)
                        {
                            <div class="emoji-category">
                                <div class="emoji-grid" 
                                     role="grid"
                                     aria-rowcount="@GetRowCount(category.Emojis.Count)"
                                     aria-colcount="8"
                                     aria-activedescendant="@GetActiveFocusedEmojiId()"
                                     aria-labelledby="category-@category.Name.Replace(" ", "-")">
                                    
                                    @if (UseVirtualization && category.Emojis.Count > 40)
                                    {
                                        @* ✅ VIRTUALIZED: Only for large emoji lists *@
                                        var emojiRows = GetEmojiRows(category.Emojis);
                                        <Virtualize Items="@emojiRows" Context="row" ItemSize="44" OverscanCount="5">
                                            <ItemContent>
                                                @foreach (var emoji in row)
                                                {
                                                    var emojiRef = emoji;
                                                    var allEmojis = GetAllEmojis();
                                                    var currentIndex = allEmojis.IndexOf(emojiRef);
                                                    <button type="button" 
                                                            class="emoji-item" 
                                                            role="gridcell"
                                                            aria-rowindex="@GetRowIndex(currentIndex)"
                                                            aria-colindex="@GetColIndex(currentIndex)"
                                                            tabindex="-1"
                                                            id="emoji-@emojiRef.Code"
                                                            @onclick="() => SelectEmoji(emojiRef)"
                                                            @onclick:stopPropagation
                                                            @onmouseenter="() => OnEmojiMouseEnter(emojiRef)"
                                                            @onmouseleave="OnEmojiMouseLeave"
                                                            aria-label="@emojiRef.Name emoji"
                                                            data-emoji-code="@emojiRef.Code">
                                                        <span aria-hidden="true">@emojiRef.Char</span>
                                                    </button>
                                                }
                                            </ItemContent>
                                            <Placeholder>
                                                <div style="display: contents;">
                                                    @for (int i = 0; i < GRID_COLUMN_COUNT; i++)
                                                    {
                                                        <div style="width: 40px; height: 40px; background: #f3f4f6; border-radius: 6px;"></div>
                                                    }
                                                </div>
                                            </Placeholder>
                                        </Virtualize>
                                    }
                                    else
                                    {
                                        @* ✅ REGULAR: For small lists (<40 emojis) *@
                                        @for (int emojiIndex = 0; emojiIndex < category.Emojis.Count; emojiIndex++)
                                        {
                                            var emoji = category.Emojis[emojiIndex];
                                            var emojiRef = emoji;
                                            var currentIndex = emojiIndex;
                                            <button type="button" 
                                                    class="emoji-item" 
                                                    role="gridcell"
                                                    aria-rowindex="@GetRowIndex(currentIndex)"
                                                    aria-colindex="@GetColIndex(currentIndex)"
                                                    tabindex="-1"
                                                    id="emoji-@emojiRef.Code"
                                                    @onclick="() => SelectEmoji(emojiRef)"
                                                    @onclick:stopPropagation
                                                    @onmouseenter="() => OnEmojiMouseEnter(emojiRef)"
                                                    @onmouseleave="OnEmojiMouseLeave"
                                                    aria-label="@emojiRef.Name emoji"
                                                    data-emoji-code="@emojiRef.Code">
                                                <span aria-hidden="true">@emojiRef.Char</span>
                                            </button>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
            
            <!-- Screen reader announcements -->
            <div class="sr-only" role="status" aria-live="polite" aria-atomic="true">
                @_screenReaderAnnouncement
            </div>
        </div>
    </div>
}