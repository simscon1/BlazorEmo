<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

	  <!-- Support both WebAssembly and Server -->
	  <RazorLangVersion>latest</RazorLangVersion>

	  <!-- NuGet Package Metadata -->
	  <PackageId>BlazorEmo</PackageId>
	  <Version>1.0.0</Version>
	  <Authors>simscon1</Authors>
	  <Company>LoneWorx LLC</Company>
	  <Product>BlazorEmo</Product>
	  <Description>A modern, fully accessible emoji picker component for Blazor WebAssembly and Server applications. Features include live search, category organization, recent emoji tracking, WCAG 2.1 AA compliance (approaching AAA), full keyboard navigation, screen reader support, and dark mode.</Description>
	  <Copyright>Copyright © 2026 LoneWorx LLC</Copyright>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>

	  <!-- URLs and Repository -->
	  <PackageProjectUrl>https://dev.azure.com/LoneWorxLLC/LoneWorx/_git/BlazorEmo.Solution</PackageProjectUrl>
	  <RepositoryUrl>https://dev.azure.com/LoneWorxLLC/LoneWorx/_git/BlazorEmo.Solution</RepositoryUrl>
	  <RepositoryType>git</RepositoryType>

	  <!-- Package Tags for Discoverability -->
	  <PackageTags>blazor;emoji;picker;webassembly;server;component;ui;accessibility;wcag;a11y;keyboard-navigation;screen-reader;dark-mode;blazor-component;emoji-picker;blazor-ui;net10</PackageTags>

	  <!-- Package Assets -->
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <PackageIcon>icon.png</PackageIcon>

	  <!-- Release Notes -->
	  <PackageReleaseNotes>
	    Initial release of BlazorEmo v1.0.0
	    - Full emoji picker with search and categories
	    - WCAG 2.1 Level AA compliant (text contrast exceeds AAA standards)
	    - Keyboard navigation and screen reader support
	    - Dark mode with enhanced contrast ratios (7:1+)
	    - LocalStorage-based recent emoji tracking
	    - Blazor WebAssembly and Server support
	  </PackageReleaseNotes>
	  
  </PropertyGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Extensions\" />
  </ItemGroup>
</Project>
